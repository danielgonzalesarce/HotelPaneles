# GEMINI_API_KEY: Required for Valentina (Google Gemini).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="AIza..."

# VITE_STRIPE_PUBLISHABLE_KEY: Stripe publishable key (optional; simulated checkout if empty).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase — persistent database (optional; without these, data stays in localStorage).
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in SQL Editor
# 3. Copy URL and anon key from Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the deployed app (used for Stripe redirects and OAuth).
APP_URL="http://localhost:3000"

# n8n — optional proxy for Valentina (Docker local, port 5678)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/valentina
VITE_USE_N8N_RECEPTIONIST=false

# Stripe API Keys (server-side, optional)
STRIPE_SECRET_KEY=

# RUC — validación simulada al registrar tenants (production = API real futura)
RUC_VALIDATION=simulation

# SUNAT — simulación académica (recomendado para sustentación)
SUNAT_SIMULATION=true
SUNAT_PROVIDER=demo
SUNAT_RUC=10743646881

# Producción real (desactivar SUNAT_SIMULATION y usar nubefact)
# SUNAT_SIMULATION=false
# SUNAT_PROVIDER=nubefact
# NUBEFACT_API_URL=https://api.nubefact.com/api/v1/TU-UUID-DE-LA-RUTA
# NUBEFACT_TOKEN=tu_token_completo
